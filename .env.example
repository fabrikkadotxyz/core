# Port 5433 on the host to avoid colliding with a local Postgres on 5432.
DATABASE_URL=postgres://fabrikka:fabrikka@localhost:5433/fabrikka

PORT=9090

# Public origin the MCP endpoint is reachable at. Used to generate the
# `claude mcp add` command shown in the UI. See docs/protocol.md.
PUBLIC_URL=http://localhost:9090

# How generated agent commands invoke the local client. Defaults to `fabrikka`,
# the client this instance serves at /install.sh (M33). Point it at the local
# build when developing the bridge itself.
# BRIDGE_COMMAND=node /abs/path/to/packages/bridge/dist/cli.js

# Where uploaded artifacts are stored. Defaults to .artifacts/ in the repo root.
# ARTIFACT_DIR=/var/lib/fabrikka/artifacts

# Seals upstream MCP credentials. Generate with: openssl rand -base64 32
# Without it, attaching a credentialed integration is REFUSED, never plaintext.
# FABRIKKA_ENCRYPTION_KEY=

# Where `pnpm tex:install` puts the TeX engine and TeX Live tree that browsers
# compile LaTeX papers with (ADR 0020). Defaults to .tex-assets/ in the repo root.
# Without them, the LaTeX output kind is simply not offered.
# TEX_ASSETS_DIR=

# M18: GitHub has no dynamic client registration, so connecting it needs a GitHub
# OAuth App for this instance (docs/operations.md, "Connections by vendor").
# Callback URL: <PUBLIC_URL>/api/connections/oauth/callback. Without these two,
# GitHub isn't offered. Atlassian and Grafana Cloud need nothing here.
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
