<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  M34 (ADR 0031). The app is signed with the hardened runtime, which notarization
  will require at launch. Under it, the bundled Node's JavaScript engine (V8)
  needs these two to generate machine code; without them it dies at startup
  ("Failed to reserve virtual memory for CodeRange"). Nothing else is granted.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
