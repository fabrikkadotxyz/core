# Port 5433 on the host to avoid colliding with a local Postgres on 5432.
DATABASE_URL=postgres://fabrikka:fabrikka@localhost:5433/fabrikka

PORT=9090

# Public origin the MCP endpoint is reachable at. Used to generate the
# `claude mcp add` command shown in the UI. See docs/protocol.md.
PUBLIC_URL=http://localhost:9090

# How the generated .mcp.json invokes the bridge. Defaults to the published
# package; point it at packages/bridge/dist/cli.js when developing.
# BRIDGE_COMMAND=node /abs/path/to/packages/bridge/dist/cli.js
