{
  "name": "fabrikka",
  "version": "0.0.0",
  "private": true,
  "description": "Multiplayer AI: a room where your team and the AI agents you already use (Claude Code, Codex, any MCP client) work one problem together, live. Self-hosted, AGPL-3.0.",
  "keywords": ["ai-agents", "mcp", "model-context-protocol", "claude-code", "codex", "multiplayer", "collaboration", "self-hosted", "realtime"],
  "homepage": "https://fabrikka.xyz",
  "repository": { "type": "git", "url": "git+https://github.com/fabrikkadotxyz/core.git" },
  "bugs": "https://github.com/fabrikkadotxyz/core/issues",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose -f docker/docker-compose.yml up -d",
    "db:down": "docker compose -f docker/docker-compose.yml down",
    "db:generate": "pnpm --filter @fabrikka/db generate",
    "db:migrate": "pnpm --filter @fabrikka/db migrate",
    "db:seed": "pnpm --filter @fabrikka/db seed",
    "acceptance": "for f in scripts/acceptance/*.mjs; do echo \"--- $f\"; node \"$f\" || exit 1; done",
    "admin": "pnpm --filter @fabrikka/server --silent admin",
    "test": "pnpm -r --if-present test",
    "tex:install": "node scripts/tex-install.mjs"
  },
  "devDependencies": {
    "@hono/node-server": "^1.19.17",
    "@modelcontextprotocol/client": "2.1.0",
    "@modelcontextprotocol/hono": "2.0.1",
    "@modelcontextprotocol/server": "2.1.0",
    "hono": "^4.13.9",
    "lib0": "^0.2.119",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "ws": "^8.21.3",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  }
}
